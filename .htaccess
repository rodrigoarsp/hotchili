# =========================================================
# CONFIGURAÇÃO APACHE / CPANEL HOSTGATOR - HOT CHILI
# =========================================================

# 1. FORÇAR HTTPS / SSL SEGURO
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. CABEÇALHOS DE SEGURANÇA E CONTROLE DE CACHE REATIVO
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set X-Permitted-Cross-Domain-Policies "none"
    Header set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval';"

    # Desativar cache agressivo em JS e JSON para sincronização instantânea
    <FilesMatch "\.(js|json|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# 3. SEGURANÇA DE DIRETÓRIOS E BLOQUEIO DE ARQUIVOS SENSÍVEIS
Options -Indexes

<FilesMatch "^\.|\.(sql|log|md|json|sh|zip|bak|config|env|git)$">
    Require all denied
</FilesMatch>

# 4. COMPRESSÃO GZIP (DESEMPENHO E VELOCIDADE MÁXIMA)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. CACHE DE MÍDIA ESTÁTICA
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 6. PÁGINA INICIAL PADRÃO
DirectoryIndex index.html index.php

